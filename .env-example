# ============================================================
# Contoh konfigurasi environment
# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK ikut git (lihat .gitignore) - aman untuk API key.
# Baris berawalan # diabaikan oleh loader di config/config.php.
#
# Kredensial database sengaja tidak ada di sini: semuanya diatur
# pada blok DATABASE di config/config.php.
# ============================================================

APP_ENV=development

# URL publik aplikasi (dipakai untuk link di dalam email).
# Kosongkan bila ingin otomatis mengikuti BASE_URL hasil deteksi.
APP_URL=


# ---------- Resend (pengiriman OTP) ----------

# API key dari https://resend.com/api-keys
# Buat dengan permission "Sending access" saja, bukan Full access.
RESEND_API_KEY=

# Alamat pengirim. Domainnya WAJIB sudah diverifikasi di Resend.
# Selama belum punya domain, pakai alamat testing resmi Resend ini dan
# kirim hanya ke email pemilik akun Resend:
MAIL_FROM="Sistem Informasi Musholla <onboarding@resend.dev>"
# Setelah domain terverifikasi, ganti menjadi mis.:
# MAIL_FROM="Sistem Informasi Musholla <noreply@domain-anda.sch.id>"

# Alamat balasan (opsional, boleh dikosongkan).
MAIL_REPLY_TO=


# ---------- OTP lupa password ----------

# Masa berlaku kode OTP dalam menit.
OTP_TTL_MINUTES=10

# Jumlah percobaan salah sebelum OTP diblokir.
OTP_MAX_ATTEMPTS=5

# Jeda minimal (detik) sebelum boleh minta OTP baru lagi.
OTP_RESEND_COOLDOWN=60
